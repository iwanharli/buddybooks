# Go
.gocache/
backend/bin/
backend/tmp/
backend/build-errors.log
backend/*.env
!backend/.env.example
backend/storage/originals/*
!backend/storage/originals/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/*.env
!frontend/.env.example

# Python OCR service
ocr-service/.venv/
ocr-service/__pycache__/
ocr-service/**/__pycache__/
*.pyc

# Eval dataset: foto uji & hasil besar tidak di-commit; kunci jawaban (.txt)
# dan struktur folder (.gitkeep) tetap disimpan.
ocr-service/eval/images/**
!ocr-service/eval/images/**/
!ocr-service/eval/images/**/.gitkeep
ocr-service/eval/results/**
!ocr-service/eval/results/.gitkeep

# OS
.DS_Store
