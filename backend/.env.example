PORT=8080
APP_ENV=development
DATABASE_URL=postgres://localhost:5432/db_buddybooks?sslmode=disable
OCR_SERVICE_URL=http://127.0.0.1:8090
# Alamat backend ini yang bisa dijangkau balik oleh ocr-service (callback fallback VLM async)
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Shared secret dicocokkan dengan header X-Webhook-Secret di /api/v1/reader/ocr/callback.
# Kosongkan untuk menonaktifkan fallback VLM sepenuhnya (endpoint webhook akan menolak semua request).
OCR_WEBHOOK_SECRET=
